generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  adminID  String @id @default(uuid())
  name     String
  email    String @unique
  password String
}

model User {
  universityID           String            @id
  name                   String
  email                  String            @unique
  password               String
  role                   String
  department             String
  accountStatus          AccountStatus     @default(PENDING)
  academicProfile        AcademicProfile?
  receivedCollaborations Collaboration[]   @relation("CollaborationInvitee")
  sentCollaborations     Collaboration[]   @relation("CollaborationInitiator")
  following              Follows[]         @relation("FollowerRelation")
  followers              Follows[]         @relation("FollowingRelation")
  createdProjects        ResearchProject[] @relation("UserCreatesProject")
  workingProjects        ResearchProject[] @relation("UserWorksOnProject")
  identityProof          String?
  profilePhoto           String?           @default("/default-avatar.svg")
  adminFeedback          String?           @default("No feedback yet")
  createdAt              DateTime          @default(now())
}

model AcademicProfile {
  profileID         String   @id @default(uuid())
  universityID      String   @unique
  researchInterests String
  biography         String
  lastUpdated       DateTime @updatedAt
  user              User     @relation(fields: [universityID], references: [universityID], onDelete: Cascade)
}

model ResearchProject {
  projectID        String           @id @default(uuid())
  title            String
  description      String
  projectDomain   String
  moderationStatus ModerationStatus @default(PENDING)
  projectStatus    ProjectStatus    @default(PROPOSED)
  createdAt        DateTime         @default(now())
  externalLinks    String[]
  universityID     String
  collaborations   Collaboration[]
  creator          User             @relation("UserCreatesProject", fields: [universityID], references: [universityID])
  teamMembers      User[]           @relation("UserWorksOnProject")
  adminFeedback     String?          @default("No feedback yet")
}

model Collaboration {
  requestID     String          @id @default(uuid())
  projectID     String
  senderID      String
  receiverID    String
  requestStatus RequestStatus   @default(PENDING)
  createdAt     DateTime        @default(now())
  project       ResearchProject @relation(fields: [projectID], references: [projectID], onDelete: Cascade)
  receiver      User            @relation("CollaborationInvitee", fields: [receiverID], references: [universityID], onDelete: Cascade)
  sender        User            @relation("CollaborationInitiator", fields: [senderID], references: [universityID], onDelete: Cascade)
}

model Follows {
  followID      String        @id @default(uuid())
  followerID    String
  followingID   String
  requestStatus RequestStatus @default(PENDING)
  follower      User          @relation("FollowerRelation", fields: [followerID], references: [universityID], onDelete: Cascade)
  following     User          @relation("FollowingRelation", fields: [followingID], references: [universityID], onDelete: Cascade)

  @@unique([followerID, followingID])
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectStatus {
  PROPOSED
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}
